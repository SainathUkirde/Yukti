# Backend — FastAPI + Python 3.11
FROM python:3.11-slim

WORKDIR /app

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Python deps
COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy source
COPY . /app

# Pre-generate synthetic data and train models if artifacts missing
RUN python data/generate.py && \
    python ml/training/train_forecaster.py && \
    python ml/training/train_fault_classifier.py && \
    python ml/training/train_failure_risk.py

EXPOSE 8000

CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
