{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CSS Cycle Record",
  "description": "One complete CSS cycle for a Baghewala well. SYNTHETIC_HISTORICAL — generated by physics simulator.",
  "type": "object",
  "required": [
    "well_id", "cycle_number", "injection_start",
    "steam_volume_cwe_m3", "injection_pressure_kpa",
    "steam_quality_fraction", "soak_days",
    "peak_reservoir_temp_c", "cycle_oil_m3", "cycle_sor",
    "production_cutoff_wor", "provenance"
  ],
  "properties": {
    "well_id": { "type": "string" },
    "cycle_number": { "type": "integer", "minimum": 1 },
    "injection_start": { "type": "string", "format": "date-time" },
    "soak_start": { "type": ["string", "null"], "format": "date-time" },
    "production_start": { "type": ["string", "null"], "format": "date-time" },
    "cycle_end": { "type": ["string", "null"], "format": "date-time" },
    "steam_volume_cwe_m3": { "type": "number", "minimum": 0 },
    "injection_pressure_kpa": { "type": "number", "minimum": 0 },
    "steam_quality_fraction": { "type": "number", "minimum": 0.5, "maximum": 1.0 },
    "soak_days": { "type": "number", "minimum": 0 },
    "peak_reservoir_temp_c": { "type": "number" },
    "cycle_oil_m3": { "type": "number", "minimum": 0 },
    "cycle_water_m3": { "type": "number", "minimum": 0 },
    "cycle_sor": { "type": "number", "minimum": 0 },
    "production_cutoff_wor": { "type": "number", "minimum": 0 },
    "cycle_duration_days": { "type": ["number", "null"] },
    "provenance": {
      "type": "string",
      "enum": ["SYNTHETIC_HISTORICAL", "FIELD_FACT"]
    }
  }
}
